# Public browser configuration, from Supabase Project Settings > API.
# Never put a service_role key, sb_secret key, database password, or access token here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Legacy anon keys can instead use VITE_SUPABASE_ANON_KEY.
